# DUPLICATE this file, rename it to .env, and fill in your actual keys.

# You can find these keys in your Supabase Dashboard -> Project Settings -> API

# The URL of your Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# The 'anon' public key (safe to expose in client-side code)
VITE_SUPABASE_ANON_KEY=your-anon-key-goes-here
