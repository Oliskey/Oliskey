{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/school-management",
      "destination": "/school",
      "permanent": true
    },
    {
      "source": "/school-app",
      "destination": "/school",
      "permanent": true
    },
    {
      "source": "/fleet-operations",
      "destination": "/fleet",
      "permanent": true
    },
    {
      "source": "/trading-app",
      "destination": "/alpha",
      "permanent": true
    },
    {
      "source": "/oliskey-alpha",
      "destination": "/alpha",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/sign-in",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/get-started",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/lab",
      "destination": "/lab/index.html"
    },
    {
      "source": "/lab/(.*)",
      "destination": "/lab/index.html"
    },
    {
      "source": "/((?!api/|assets/|hq/|products/|lab/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/lab/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hq/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!lab/|lab$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' blob: data: https://*.supabase.co; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/lab(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}